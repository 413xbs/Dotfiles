{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "display": {
        "color": {
            "keys": "red"
        }
    },
    "logo": {
        "source": "/home/413xbs/Pictures/epfp.jpg",
        "type": "kitty",
        "width": 32
    },
    "modules": [
        {"type": "title", "format": "{#1;31}󱢺 {host-name}"},
        "break",
        {"type": "os", "key": "󰇅 OS"},
        {"type": "kernel", "key": "󰆍 Kernel"},
        {"type": "wm", "key": " WM"},
        {"type": "cpu", "key": " CPU"},
        {"type": "gpu", "key": " GPU"},
        {"type": "memory", "key": " Memory"},
        {"type": "swap", "key": "󰯍 Swap"},
        {"type": "disk", "key": "󱛟 Disk"},
        "break",
        {"type": "colors", "symbol": "circle"}
  ]
}
