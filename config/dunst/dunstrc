[global]
    monitor = 0
    follow = mouse
    width = (250, 300)
    height = (0, 100)
    origin = top-center
    offset = (0, 16)
    scale = 0
    notification_limit = 5
    progress_bar = true
    transparency = 0
    alignment = center
    font = Adwaita 12
    corner_radius = 4
    progress_bar_corner_radius = 4
    frame_width = 2
    frame_color = "#181818"
    highlight = "#e80a4d"

[urgency_low]
    background = "#080808"
    foreground = "#ffffff"
    timeout = 4

[urgency_normal]
    background = "#080808"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#080808"
    foreground = "#ffffff"
    timeout = 12
